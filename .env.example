# ─────────────────────────────────────────────────────────────
# Airco DHVANI AI — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. All keys below are SERVER-ONLY secrets.
# ─────────────────────────────────────────────────────────────

# Sarvam AI — used for STT (Saaras v3 realtime) AND TTS (Bulbul v3).
# Auth header: api-subscription-key
SARVAM_API_KEY=

# Cerebras Inference — LLM (gpt-oss-120b). OpenAI-compatible.
# Auth header: Authorization: Bearer <key>
CEREBRAS_API_KEY=

# ── Server ───────────────────────────────────────────────────
# Port the backend WebSocket server listens on.
PORT=8080
# CORS origin allowed for the browser (Next.js dev server).
WEB_ORIGIN=http://localhost:3000
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Voice pipeline tuning ────────────────────────────────────
# Default language used for STT when the user selects AUTO, before the
# first utterance is detected. BCP-47 code. See shared/languages.
DEFAULT_AUTO_LANGUAGE=hi-IN
# Maximum number of recent messages sent to the LLM as context.
MAX_CONTEXT_MESSAGES=12
# Minimum confidence to accept a newly detected language (0..1).
LANGUAGE_CONFIDENCE_THRESHOLD=0.6
# Audio sample rate (Hz) sent to Sarvam STT.
STT_SAMPLE_RATE=16000
# TTS preferred voice (Sarvam Bulbul speaker name). Empty = provider default.
TTS_VOICE=
