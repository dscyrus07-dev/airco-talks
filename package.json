{
  "name": "airco-talks",
  "version": "0.1.0",
  "private": true,
  "description": "Airco Talks — real-time two-way voice translator for Indian languages.",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
